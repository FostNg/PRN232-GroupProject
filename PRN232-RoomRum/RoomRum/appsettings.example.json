{
  "ConnectionStrings": {
    "RoomRumConnection": "Server=YOUR_SQL_SERVER;Database=RoomRum_db;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "RoomRum.API",
    "Audience": "RoomRum.Mobile",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },
  "Maps": {
    "GeocodingUrl": "https://photon.komoot.io/api/",
    "UserAgent": "RoomRum/1.0 (+https://github.com/FostNg/PRN232-GroupProject)"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "AuthPermitLimit": 30
  },
  "EmailVerification": {
    "ApiBaseUrl": "https://YOUR_API_HOST",
    "TokenMinutes": 60
  },
  "Email": {
    "DeliveryMethod": "Smtp",
    "PickupDirectory": "App_Data/maildrop"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "FromEmail": "",
    "Username": "",
    "Password": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
